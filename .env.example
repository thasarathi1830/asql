# ===== PHANTOM Environment Variables =====
# Mode: 'cloud' or 'local' (default: local)
PHANTOM_MODE=local

# ===== Supabase (cloud mode) =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== PostgreSQL (local mode) =====
DATABASE_URL=postgresql://postgres:password@localhost:5432/phantom

# ===== Neo4j =====
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ===== Analytics Service =====
ANALYTICS_API_URL=http://localhost:8000
ANALYTICS_API_KEY=phantom-internal-api-key-change-me

# ===== Blockchain =====
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-key
DEPLOYER_PRIVATE_KEY=0x_your_private_key
PHANTOM_CONTRACT_ADDRESS=0x_deployed_contract_address

# ===== Frontend (Vite) =====
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_ANALYTICS_API_URL=http://localhost:8000
VITE_ENABLE_DEMO_MODE=true

